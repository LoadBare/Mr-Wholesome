{
	"compilerOptions": {
		"target": "es2024",
		"module": "nodenext",
		"types": ["node"],
		"rootDir": "./src",
		"outDir": "dist",
		"sourceMap": true,
		"incremental": true,
		"newLine": "lf",
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"preserveConstEnums": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true
	},
	"include": ["src"]
}